{
  "name": "@vakt/cli",
  "version": "0.4.0",
  "description": "Secure MCP runtime — unified config, policy enforcement, audit logging, registry verification",
  "bin": {
    "vakt": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/vakt",
    "test": "bats tests/",
    "test:coverage": "bun test --coverage --coverage-reporter lcov",
    "test:unit": "bun test tests/unit/",
    "test:all": "bun test tests/unit/ && bats tests/",
    "knip": "knip",
    "lint": "eslint src/ --ignore-pattern '**/*.test.ts'",
    "lint:fix": "eslint src/ --ignore-pattern '**/*.test.ts' --fix",
    "lint:md": "markdownlint-cli2 \"docs/adr/**/*.md\"",
    "lint:adr": "bun run scripts/check-adrs.ts",
    "check:tool-enum": "bun run scripts/check-tool-enum.ts",
    "ci:build": "node --experimental-strip-types scripts/ci-build.ts",
    "ci:lint": "node --experimental-strip-types scripts/ci-lint.ts",
    "ci:test": "node --experimental-strip-types scripts/ci-test.ts",
    "ci:security": "node --experimental-strip-types scripts/ci-security.ts",
    "test:mutation": "stryker run",
    "lint:docs": "bun run lint:md && bun run lint:adr",
    "pretest": "chmod +x src/vakt.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stryker-mutator/core": "10.1.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.0.0",
    "knip": "^6.43.0",
    "markdownlint-cli2": "^0.24.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osloer-industries/vakt.git"
  },
  "packageManager": "bun@1.3.10",
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "protobufjs": "7.6.6",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}