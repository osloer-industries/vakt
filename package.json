{
  "name": "@vakt/cli",
  "version": "0.4.0",
  "description": "Secure MCP runtime — unified config, policy enforcement, audit logging, registry verification",
  "bin": {
    "vakt": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/vakt",
    "test": "bats tests/",
    "test:unit": "bun test tests/unit/",
    "test:all": "bun test tests/unit/ && bats tests/",
    "knip": "knip",
    "lint": "eslint src/ --ignore-pattern '**/*.test.ts'",
    "lint:fix": "eslint src/ --ignore-pattern '**/*.test.ts' --fix",
    "lint:md": "markdownlint-cli2 \"docs/adr/**/*.md\"",
    "lint:adr": "bun run scripts/check-adrs.ts",
    "check:tool-enum": "bun run scripts/check-tool-enum.ts",
    "lint:docs": "bun run lint:md && bun run lint:adr",
    "pretest": "chmod +x src/vakt.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.0.0",
    "knip": "^6.43.0",
    "markdownlint-cli2": "^0.24.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tn819/vakt.git"
  },
  "packageManager": "bun@1.3.10",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-otlp-grpc": "^0.26.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
